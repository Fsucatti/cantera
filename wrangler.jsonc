{
  // Static site plus an API. Only /api/* reaches the Worker code.
  "name": "cantera",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cantera",
      // To publish your own copy, use the id from `wrangler d1 create cantera`.
      "database_id": "06bb59dd-1194-4256-b6af-35a750687c94",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, for messages from the app's fictional people. On the Free plan it fails at the limit and never charges.
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "4203", "simple": { "limit": 8, "period": 60 } }
  ],
  // Once a day, delete expired guest accounts and sessions.
  "triggers": { "crons": ["17 4 * * *"] }
}
